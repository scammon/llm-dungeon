# --- Database (Postgres) ---
# On Dailey the managed DB injects DATABASE_URL automatically.
# Locally, set either DATABASE_URL or the individual DB_* vars.
# If neither is set, the app runs with an in-memory store (dev only, not persisted).
DATABASE_URL=postgresql://user:password@localhost:5432/llm_dungeon
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=llm_dungeon

# --- Dailey AI (narrator) ---
# On Dailey, enabling Dailey AI injects these automatically.
# Without them the game still runs, using fallback (non-LLM) narration text.
# DAILEY_AI_BASE_URL=
# DAILEY_AI_KEY=
# DAILEY_AI_MODEL=dailey-fast
# DAILEY_AI_NOTHINK=0
# DAILEY_AI_TIMEOUT=60
# DAILEY_AI_TEMP=0.8
